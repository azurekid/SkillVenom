# SkillVenom lab environment. Copy to .env and fill in for YOUR authorized lab tenants.
# .env is gitignored. Never commit real values, secrets, or tokens.

# ----- Microsoft Entra ID (lab tenant) -----
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Verified domain for the canary user. Default matches the identifiers hardcoded in the scenarios.
ENTRA_LAB_DOMAIN=azurehacking.com
ENTRA_CANARY_USER_UPN=vs001@azurehacking.com
ENTRA_CANARY_GROUP=ai-venom
# Dedicated lab app registration used by the entra-graph-canary connector (least privilege).
ENTRA_APP_CLIENT_ID=
ENTRA_APP_CLIENT_SECRET=

# ----- Azure (lab subscription) -----
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=westeurope
AZURE_CANARY_RG_VS008=sv008-canary-rg
AZURE_CANARY_RG_VS009=sv009-canary-rg
# Object id of the disposable principal that receives the Reader grant in VS008/VS009.
# provision.sh azure can create one named below and print its object id.
AZURE_CANARY_PRINCIPAL_NAME=skillvenom-canary-principal
AZURE_CANARY_PRINCIPAL_ID=

# ----- GitHub (lab organization) -----
GITHUB_ORG=your-lab-org
GITHUB_CANARY_SINK=sv003-canary-sink
GITHUB_CANARY_REPO_VS005=sv005-canary-repo

# ----- Azure DevOps (lab organization) -----
ADO_ORG=https://dev.azure.com/your-lab-org
ADO_CANARY_PROJECT_VS004=sv004-canary-project
ADO_CANARY_PROJECT_VS006=sv006-canary-project
