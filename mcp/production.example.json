{
  "servers": {
    "azure-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@3.0.0-beta.48", "server", "start"]
    },
    "github-mcp": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "azure-devops-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp@2.10.0", "${input:ado-organization}"]
    },
    "entra-graph-canary": {
      "type": "stdio",
      "command": "${workspaceFolder}/connectors/entra-graph-mcp/.venv/bin/python",
      "args": ["${workspaceFolder}/connectors/entra-graph-mcp/server.py"],
      "env": {
        "AZURE_TENANT_ID": "${input:entra-tenant-id}",
        "AZURE_CLIENT_ID": "${input:entra-client-id}",
        "AZURE_CLIENT_SECRET": "${input:entra-client-secret}",
        "SV001_ALLOWED_USER_UPN": "${input:entra-canary-user}",
        "SV001_ALLOWED_GROUP": "${input:entra-canary-group}",
        "SV001_WRITE_CONFIRMATION": "${input:entra-write-confirmation}"
      }
    },
    "azure-rbac-canary": {
      "type": "stdio",
      "command": "${workspaceFolder}/connectors/azure-rbac-mcp/.venv/bin/python",
      "args": ["${workspaceFolder}/connectors/azure-rbac-mcp/server.py"],
      "env": {
        "AZURE_SUBSCRIPTION_ID": "${input:azure-subscription-id}",
        "SV_ALLOWED_PRINCIPAL_ID": "${input:azure-canary-principal-id}",
        "SV_ALLOWED_SCOPE": "${input:azure-canary-scope}",
        "SV_WRITE_CONFIRMATION": "${input:azure-write-confirmation}"
      }
    }
  },
  "inputs": [
    {
      "id": "ado-organization",
      "type": "promptString",
      "description": "Azure DevOps organization name"
    },
    {
      "id": "entra-tenant-id",
      "type": "promptString",
      "description": "Entra lab tenant ID"
    },
    {
      "id": "entra-client-id",
      "type": "promptString",
      "description": "Entra lab application client ID"
    },
    {
      "id": "entra-client-secret",
      "type": "promptString",
      "description": "Short-lived Entra lab application secret",
      "password": true
    },
    {
      "id": "entra-canary-user",
      "type": "promptString",
      "description": "Allowlisted Entra canary user UPN"
    },
    {
      "id": "entra-canary-group",
      "type": "promptString",
      "description": "Allowlisted Entra canary group"
    },
    {
      "id": "entra-write-confirmation",
      "type": "promptString",
      "description": "Type: ADD <canary-user-upn> TO <canary-group>"
    },
    {
      "id": "azure-subscription-id",
      "type": "promptString",
      "description": "Azure lab subscription ID"
    },
    {
      "id": "azure-canary-principal-id",
      "type": "promptString",
      "description": "Canary principal (object) ID to receive the Reader grant"
    },
    {
      "id": "azure-canary-scope",
      "type": "promptString",
      "description": "Canary resource-group scope: /subscriptions/<id>/resourceGroups/sv008-canary-rg"
    },
    {
      "id": "azure-write-confirmation",
      "type": "promptString",
      "description": "Type: ASSIGN Reader TO <principal-id> ON <scope>"
    }
  ]
}