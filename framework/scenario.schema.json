{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillvenom.local/schema/scenario.schema.json",
  "title": "SkillVenom scenario",
  "type": "object",
  "required": ["id", "title", "endpoint", "attack_vector", "target_task", "artifacts", "mcp", "modes"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "endpoint": {"enum": ["azure", "entra-id", "github", "azure-devops"]},
    "source_endpoint": {"enum": ["azure", "entra-id", "github", "azure-devops"]},
    "attack_vector": {"type": "string", "minLength": 1},
    "techniques": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["draft", "validated", "published"]},
    "author": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owasp_llm": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mitre_atlas": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "cleanup": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_task": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "trust", "delivery"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "trust": {"enum": ["trusted", "untrusted"]},
          "delivery": {"type": "string", "minLength": 1},
          "role": {"enum": ["payload", "weaponized-skill", "trusted-skill", "target-content", "canary-data", "script"]}
        },
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "object",
      "required": ["servers", "required_tools"],
      "properties": {
        "servers": {"type": "array", "items": {"type": "string"}},
        "required_tools": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "object",
      "required": ["dry-run"],
      "properties": {
        "dry-run": {"$ref": "#/$defs/mode"},
        "lab-impact": {"$ref": "#/$defs/mode"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mode": {
      "type": "object",
      "required": ["writes_allowed", "expected_result"],
      "properties": {
        "writes_allowed": {"type": "boolean"},
        "requires_operator_approval": {"type": "boolean"},
        "canary_targets": {"type": "array", "items": {"type": "string"}},
        "expected_result": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
